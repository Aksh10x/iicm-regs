# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas free (M0) cluster: Atlas > Connect > Drivers > copy the connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=iicm

# Gmail SMTP. SMTP_PASS is a 16-character Google App Password, NOT your normal Gmail password.
SMTP_USER=akshathsurwase@gmail.com
SMTP_PASS=
MAIL_FROM_NAME=IICM 9.0
MAIL_SUBJECT=IICM 9.0: your registration has been received
# MAIL_REPLY_TO=iitkgpcl.iicm9.0@gmail.com

# Only these email domains may register (comma-separated). Default: kgpian.iitkgp.ac.in. Use * to allow any.
# EMAIL_DOMAINS=kgpian.iitkgp.ac.in

# Optional: the Events tab published as CSV, so events stay editable in the Google Sheet.
# Leave empty to use the bundled events.csv.
EVENTS_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQqhSf5iPPEyLNYeyh8oJzQiVg_sAHXxhcAvD2OUX1DVg6H1YH5a5Gba11H_0vHJtqvBqT79JVkA5fT/pub?gid=358194801&single=true&output=csv

# Only needed if the website is hosted on a different domain from the API (comma-separated origins).
# ALLOWED_ORIGIN=https://iicm.pages.dev

# Local server port (node server.js)
PORT=3000
